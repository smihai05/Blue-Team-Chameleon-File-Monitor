# ============================================================
# RESOURCE PATH
# ============================================================

def resource_path(filename):
    """
    Găsește fișierele atât când rulezi .py,
    cât și când aplicația este împachetată cu PyInstaller.
    """

    if getattr(sys, "frozen", False):
        base_path = sys._MEIPASS
    else:
        base_path = os.path.dirname(
            os.path.abspath(__file__)
        )

    return os.path.join(
        base_path,
        filename
    )


# ============================================================
# FILE HELPERS
# ============================================================

def get_file_info(path):
    try:
        stat = path.stat()

        return {
            "path": str(path),
            "name": path.name,
            "extension": path.suffix.lower(),
            "size": stat.st_size,
            "modified": stat.st_mtime,
            "hash": None,
        }

    except (PermissionError, OSError):
        return None


def scan_directory(
    directory,
    include_all=False,
    progress_callback=None,
):
    results = {}

    directory = Path(directory)

    if not directory.exists():
        return results

    checked = 0

    ignored_directories = {
        "$Recycle.Bin",
        "System Volume Information",
        "node_modules",
        ".git",
    }

    for root, dirs, files in os.walk(directory):

        dirs[:] = [
            d
            for d in dirs
            if d not in ignored_directories
        ]

        for filename in files:

            path = Path(root) / filename

            if not include_all:
                if path.suffix.lower() not in WATCH_EXTENSIONS:
                    continue

            info = get_file_info(path)

            if info is not None:
                results[str(path)] = info

            checked += 1

            if (
                progress_callback is not None
                and checked % 10 == 0
            ):
                progress_callback(checked)

    if progress_callback is not None:
        progress_callback(checked)

    return results


# ============================================================
# SNAPSHOT
# ============================================================

def load_snapshot():
    if not SNAPSHOT_FILE.exists():
        return {}

    try:
        with open(
            SNAPSHOT_FILE,
            "r",
            encoding="utf-8",
        ) as file:

            return json.load(file)

    except (
        json.JSONDecodeError,
        OSError,
    ):
        return {}


def save_snapshot(data):
    try:
        with open(
            SNAPSHOT_FILE,
            "w",
            encoding="utf-8",
        ) as file:

            json.dump(
                data,
                file,
                indent=2,
            )

    except OSError:
        pass


